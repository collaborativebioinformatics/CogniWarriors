FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

WORKDIR /app

COPY requirements-training-head.txt /app/requirements-training-head.txt
RUN pip install --no-cache-dir -r /app/requirements-training-head.txt

COPY . /app

CMD ["sh", "-c", "uvicorn training_head.main:app --host ${HOST:-0.0.0.0} --port ${PORT:-8001}"]
