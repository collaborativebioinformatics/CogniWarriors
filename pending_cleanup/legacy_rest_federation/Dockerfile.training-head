FROM python:3.9-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY worker.py .

RUN mkdir -p /data/center1 /data/center2

EXPOSE 8001

CMD ["python3", "worker.py", "--center-id", "center1", "--data-dir", "/data/center1", "--port", "8001"]
